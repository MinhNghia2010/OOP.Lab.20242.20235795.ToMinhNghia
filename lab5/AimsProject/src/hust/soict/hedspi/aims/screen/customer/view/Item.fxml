<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-border-color: #000000; -fx-border-width: 2px;" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hust.soict.hedspi.aims.screen.customer.controller.ItemController">
    <children>
        <VBox alignment="CENTER" prefHeight="175.0" prefWidth="305.0">
            <children>
                <Label fx:id="lblTitle" alignment="CENTER" prefHeight="50.0" prefWidth="305.0" />
                <Label fx:id="lblCost" alignment="CENTER" prefHeight="50.0" prefWidth="305.0" />
                <HBox alignment="CENTER" prefHeight="50.0" prefWidth="305.0" spacing="20.0">
                    <children>
                        <Button fx:id="btnAddToCart" mnemonicParsing="false" onAction="#btnAddToCartClicked" prefHeight="50.0" prefWidth="105.0" text="Add to Cart" />
                        <Button fx:id="btnPlay" mnemonicParsing="false" onAction="#btnPlayClicked" prefHeight="50.0" prefWidth="105.0" text="Play" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>